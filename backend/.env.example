# 配置模板：复制成 backend/.env 再填真实值
#   cp backend/.env.example backend/.env
#
# 字段名必须和 app/config.py 里 Settings 的属性名对上（pydantic-settings 大小写不敏感，
# 但不做同义词映射——字段叫 upload_path，这里写 UPLOAD_DIR 是读不到的，会静默落回默认值）。
# 每一项的说明见仓库根 README 的「配置说明」一节。
#
# 注意：这个文件**不能**放任何真实密钥。

APP_NAME=政务政策 RAG 系统
DEBUG=true
API_PREFIX=/api

# MySQL。密码里有特殊字符时要么 URL 编码，要么给整个值加引号
DATABASE_URL="mysql+pymysql://root:password@127.0.0.1:3306/gov_rag?charset=utf8mb4"

# 大模型。MODEL_PROVIDER 目前刻意不接线（create_chat_model 里硬编码走 OpenAI 兼容端点）
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-替换成你自己的
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Ollama（预留，当前未接线）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

UPLOAD_PATH=data/uploads
MAX_UPLOAD_MB=20

# 本地 embedding 模型。EMBEDDING_DIM 必须和模型一致（bge-small-zh-v1.5 = 512）
EMBEDDING_MODEL=bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIM=512

# Milvus（Docker standalone）。本地不带鉴权，MILVUS_TOKEN 留空
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=policy_child_chunks

# 百炼（预留，当前未接线）
DASHSCOPE_API_KEY=

# 重排。别改回 bge-reranker-base：它本地没有权重，加载要联网下 ~1.1G
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ENABLE_RERANKER=true

# 以下四个开关目前未接线，见 README「已知问题」
ENABLE_QUERY_REWRITE=false
WARMUP_ON_STARTUP=true
WARMUP_LLM_ON_STARTUP=false
ENABLE_LLM_JUDGE=false

# 检索：开启重排时每个召回器取 RETRIEVAL_TOP_K 条候选，重排后最多留 RERANK_TOP_K 条。
# 所以 top_k=8 默认只回 4 条
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
# 归一化后的证据阈值，低于它判为「证据不足」并拒答。启发式起点，没有离线评测支撑
MIN_EVIDENCE_SCORE=0.25

# 问答：政策问答要贴着原文，所以温度比默认低
QA_TEMPERATURE=0.2
# 送进 LLM 的证据正文总字符上限；超了从尾部整条丢证据（不截断，保证 [n] 有效）
QA_MAX_CONTEXT_CHARS=6000

# 前端 dev server 的源，逗号分隔。factory.py 的 CORSMiddleware 读它
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
